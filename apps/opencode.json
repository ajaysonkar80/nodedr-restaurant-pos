{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "river": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "River AI",
      "options": {
        "baseURL": "https://api.river.ai/v1"
      },
      "models": {
        "deepseek-v41-flash": {
          "name": "DeepSeek V4.1 Flash",
          "id": "deepseek-ai/DeepSeek-V4.1-Flash"
        },
        "deepseek-v41-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "id": "deepseek-ai/DeepSeek-V4.1-Flash-1017"
        },
        "glm-53-flash": {
          "name": "GLM 5.3 Flash",
          "id": "GLM-5.3-Flash"
        },
        "nemotron-35-super-vl": {
          "name": "NVIDIA Nemotron 3.5 Super VL",
          "id": "NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4"
        }
      }
    }
  },
  "plugin": [
    "@hueyexe/opencode-ensemble@0.16.0"
  ],
  "permission": {
    "external_directory": {
      "~/.local/share/opencode/worktree/**": "allow"
    }
  },
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ahfduuscfeohpdegulaw&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "kage": {
      "enabled": false,
      "type": "remote",
      "url": "https://kage.design/mcp"
    },
    "servers": {
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      }
    }
  }
}